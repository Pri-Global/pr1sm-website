# Supabase — copy to .env.local (local) AND set in Vercel → Settings → Environment Variables
# Supabase Dashboard → Settings → API

VITE_SUPABASE_URL=https://your-project.supabase.co

# Use the LEGACY "anon public" JWT key (starts with eyJ...) — most reliable with supabase-js.
# Do NOT use sb_secret_ keys in the frontend.
# Publishable keys (sb_publishable_...) may work locally but can fail on Vercel if misconfigured.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# After changing env vars on Vercel you MUST redeploy (Deployments → Redeploy).
